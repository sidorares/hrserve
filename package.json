{
  "version": "1.4.0",
  "name": "hrserve",
  "license": "MIT",
  "author": {
    "name": "Andrey Sidorov",
    "email": "andrey.sidorov@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sidorares/hrserve.git"
  },
  "bin": {
    "hrserve": "./dist/bin/hrserve.js"
  },
  "main": "./dist/lib/hrserve.js",
  "types": "./dist/lib/hrserve.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "dev:ts": "tsx bin/hrserve.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --import tsx --test \"test/unit/*.test.ts\"",
    "test:browser": "node --import tsx --test \"test/browser/*.test.ts\"",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chokidar": "^3.6.0",
    "csstree-validator": "^3.0.0",
    "jiti": "^2.7.0",
    "mime-types": "^2.1.35",
    "picomatch": "^2.3.2",
    "playwright": "^1.62.1",
    "serve-handler": "^6.1.6",
    "yargs": "^17.7.2",
    "zod": "^4.4.3"
  },
  "keywords": [
    "dx",
    "hmr",
    "development server",
    "hot reload",
    "hot module replacement",
    "live reload",
    "live module replacement",
    "live module swapping",
    "live module updating",
    "live module reloading"
  ],
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.10.2",
    "@types/picomatch": "^4.0.3",
    "@types/serve-handler": "^6.1.4",
    "@types/yargs": "^17.0.33",
    "tsx": "^4.19.4",
    "typescript": "^5.7.2"
  }
}
